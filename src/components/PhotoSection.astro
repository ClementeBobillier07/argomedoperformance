---
// Sección a pantalla completa con texto sobre la foto (referente: Loam House)
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Stat { value: string; label: string }
interface Props { image: ImageMetadata; alt: string; number?: string; kicker?: string; align?: 'left' | 'right'; stats?: Stat[]; position?: string }
const { image, alt, number, kicker, align = 'left', stats = [], position = '50% 50%' } = Astro.props;
---
<section class:list={['psec', `psec--${align}`]}>
  <div class="psec__media photo">
    <Picture src={image} alt={alt} widths={[828, 1280, 1920, 2560]} sizes="100vw" formats={['avif', 'webp']} class="graded" loading="lazy" style={`object-position:${position}`} />
  </div>
  <div class="psec__inner container">
    <div class="psec__text" data-reveal>
      {number && <p class="psec__num num">{number}</p>}
      {kicker && <p class="label">{kicker}</p>}
      <slot />
    </div>
    {stats.length > 0 && (
      <dl class="psec__stats" data-reveal style="--d:120ms">
        {stats.map((s) => (
          <div><dt class="label">{s.label}</dt><dd class="num">{s.value}</dd></div>
        ))}
      </dl>
    )}
  </div>
</section>

<style>
  .psec { position: relative; isolation: isolate; min-height: 100svh; display: grid; overflow: hidden; }
  .psec__media { position: absolute; inset: 0; z-index: -1; }
  .psec__media::after { content: ''; position: absolute; inset: 0; background: var(--scrim-left), var(--scrim-bottom); }
  .psec--right .psec__media::after { background: linear-gradient(270deg, rgb(10 10 11 / 0.88) 0%, rgb(10 10 11 / 0.5) 40%, rgb(10 10 11 / 0) 75%), var(--scrim-bottom); }
  .psec__inner { display: grid; grid-template-rows: 1fr auto; padding-block: calc(var(--nav-h) + 3rem) clamp(2rem, 5vw, 4rem); gap: 3rem; }
  .psec__text { align-self: center; max-width: 46rem; display: grid; gap: 1.25rem; }
  .psec--right .psec__text { justify-self: end; }
  .psec__num { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1; color: var(--accent); font-weight: 400; letter-spacing: -0.04em; }
  .psec__stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--hairline-strong); }
  .psec__stats div { display: grid; gap: 0.35rem; }
  .psec__stats dt { order: 2; color: var(--text-2); }
  .psec__stats dd { order: 1; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1; color: var(--text); }
  @media (max-width: 767px) {
    .psec__media::after { background: linear-gradient(180deg, rgb(10 10 11 / 0.35) 0%, rgb(10 10 11 / 0.6) 45%, rgb(10 10 11 / 0.95) 100%); }
    .psec__text { align-self: end; }
    .psec--right .psec__text { justify-self: start; }
  }
</style>
