---
// Set mínimo de íconos inline (trazo 1.6, estilo SF Symbols)
interface Props { name: 'arrow' | 'arrow-down' | 'menu' | 'close' | 'phone' | 'mail' | 'pin' | 'whatsapp' | 'waze' | 'maps' | 'play'; size?: number; label?: string }
const { name, size = 20, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" {...a11y}>
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 5v14M6 13l6 6 6-6" />}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'phone' && <path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>}
  {name === 'pin' && <><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === 'maps' && <><path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2-6-2z" /><path d="M9 4v14M15 6v14" /></>}
  {name === 'play' && <path d="M8 5v14l11-7z" fill="currentColor" stroke="none" />}
  {name === 'whatsapp' && <path fill="currentColor" stroke="none" d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.1-1.3A9.9 9.9 0 1 0 12.04 2zm0 18.1a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-3-.2-.3a8.2 8.2 0 1 1 6.9 3.9zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3z" />}
  {name === 'waze' && <><path d="M20 11.2a8 8 0 0 0-15.6-2.5c-.3 1-.2 2.3-1.4 2.9.4 1.8 1.8 3 3.5 3.7" /><path d="M9 17.8c1.9.6 4 .6 6-.2A8 8 0 0 0 20 11.2" /><circle cx="8" cy="18.5" r="1.6" /><circle cx="16.5" cy="18" r="1.6" /><path d="M10 10.5h.01M15 10.5h.01M10 13.5c1.2 1 2.8 1 4 0" /></>}
</svg>
