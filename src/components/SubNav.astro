---
// Barra secundaria sticky (como las páginas de producto de Apple)
import { nav } from '../data/site';
interface Props { section: 'argomedo' | 'showroom' | 'contacto' }
const { section } = Astro.props;
const labels = { argomedo: 'Argomedo', showroom: 'Showroom', contacto: 'Contáctenos' } as const;
const item = nav.find((n) => n.label === labels[section]);
const path = Astro.url.pathname.replace(/\/?$/, '/');
---
{item?.children && (
  <nav class="subnav" aria-label={`Secciones de ${labels[section]}`}>
    <div class="container subnav__inner">
      <p class="subnav__title">{labels[section]}</p>
      <ul>
        {item.children.map((c) => (
          <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>
)}

<style>
  .subnav {
    position: sticky; top: 0; z-index: 30;
    background: var(--glass); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: inset 0 -1px 0 var(--hairline);
  }
  .subnav__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 52px; }
  .subnav__title { font-weight: 600; font-size: 1.0625rem; letter-spacing: -0.015em; }
  .subnav ul { list-style: none; padding: 0; display: flex; gap: 0.25rem; overflow-x: auto; scrollbar-width: none; }
  .subnav ul::-webkit-scrollbar { display: none; }
  .subnav a { display: block; padding: 0.35rem 0.8rem; border-radius: var(--radius-pill); font-size: 0.8125rem; color: var(--text-2); white-space: nowrap; transition: background-color var(--dur-fast), color var(--dur-fast); }
  .subnav a:hover { color: var(--text); }
  .subnav a[aria-current='page'] { background: var(--ink); color: var(--white); }
  @media (max-width: 599px) { .subnav__title { display: none; } .subnav__inner { justify-content: center; } }
</style>
