---
import { Picture } from 'astro:assets';
import { brands } from '../data/site';

// Solo fotos originales de Argomedo (sin retoque ni IA)
import maserati from '../../assets/fotos-originales/biblioteca/2013-08/20130829_172246.jpg';
import showroom from '../../assets/fotos-originales/tema/home.jpg';
import lambo from '../../assets/fotos-originales/biblioteca/2013-08/la-foto-4.jpg';
import maseratiRear from '../../assets/fotos-originales/biblioteca/2013-08/20130829_172426.jpg';

const slides = [
  { src: maserati, alt: 'Maserati GranTurismo MC Stradale blanco en el showroom de Argomedo Performance', caption: 'Maserati GranTurismo MC Stradale', pos: '50% 55%' },
  { src: showroom, alt: 'Showroom de Argomedo Performance con Lamborghini Gallardo, Corvette, Honda NSX y Shelby GT500', caption: 'Showroom · Recoleta', pos: '50% 60%' },
  { src: lambo, alt: 'Lamborghini Gallardo Spyder plateado, vista trasera', caption: 'Lamborghini Gallardo Spyder', pos: '50% 60%' },
  { src: maseratiRear, alt: 'Maserati GranTurismo MC Stradale, vista trasera', caption: 'Maserati GranTurismo MC', pos: '50% 62%' },
];
---
<section class="hero container" data-hero aria-label="Presentación">
  <div class="hero__tile">
    <div class="hero__media">
      {slides.map((s, i) => (
        <figure class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide data-caption={s.caption}>
          <Picture
            src={s.src}
            alt={s.alt}
            widths={[640, 960, 1440, 1920]}
            sizes="(max-width: 1280px) 100vw, 1280px"
            formats={['avif', 'webp']}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            style={`object-position:${s.pos}`}
          />
        </figure>
      ))}
      <div class="hero__scrim"></div>
    </div>

    <div class="hero__content">
      <p class="label hero__kicker"><span class="dot"></span>Recoleta · Santiago · Desde 1970</p>
      <h1 class="hero__title">Mecánica de alto rendimiento para autos de lujo.</h1>
      <p class="hero__lead">Taller familiar especializado en autos deportivos y clásicos, con garantía profesional.</p>
      <div class="hero__ctas">
        <a class="btn btn--light" href="/showroom/autos-en-venta/">Ver showroom</a>
        <a class="btn btn--glass" href="/contacto/">Contáctenos</a>
      </div>
      <div class="hero__bars" aria-hidden="true">
        {slides.map((_, i) => <i class:list={{ 'is-active': i === 0 }}><b></b></i>)}
      </div>
      <p class="sr-only" aria-live="polite" data-slide-caption>{slides[0].caption}</p>
    </div>

    <ul class="hero__brands" aria-label="Marcas con las que trabajamos">
      {brands.map((b) => (
        <li><img src={b.src} alt={b.name} /></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero { padding-top: calc(var(--nav-h) + 0.75rem); }
  .hero__tile {
    position: relative; isolation: isolate; overflow: hidden;
    border-radius: var(--radius-l);
    min-height: min(82svh, 780px);
    display: grid; grid-template-columns: 1fr auto; gap: 2rem;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    color: var(--on-photo); background: var(--ink);
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s var(--ease-in-out); }
  .hero__slide.is-active { opacity: 1; }
  .hero__slide :global(picture), .hero__slide :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__slide :global(img) { transform: scale(1.04); transition: transform 8s linear; }
  .hero__slide.is-active :global(img) { transform: scale(1); }
  /* Degradado solo abajo a la izquierda (texto) y en el borde derecho (logos): la foto queda limpia */
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 70% at 0% 100%, rgb(0 0 0 / 0.62) 0%, rgb(0 0 0 / 0.25) 45%, rgb(0 0 0 / 0) 70%),
      linear-gradient(270deg, rgb(0 0 0 / 0.35) 0%, rgb(0 0 0 / 0) 18%);
  }

  /* Texto abajo a la izquierda */
  .hero__content { align-self: end; justify-self: start; max-width: 30rem; display: grid; justify-items: start; gap: 0.75rem; }
  .hero__kicker { color: rgb(255 255 255 / 0.9); font-size: 0.6875rem; }
  .hero__title { font-size: clamp(1.625rem, 1.25rem + 1.5vw, 2.5rem); line-height: 1.08; letter-spacing: -0.03em; font-weight: 600; color: var(--on-photo); text-wrap: balance; text-shadow: 0 1px 20px rgb(0 0 0 / 0.25); }
  .hero__lead { font-size: 0.9375rem; line-height: 1.5; color: rgb(255 255 255 / 0.85); max-width: 24rem; }
  /* CTAs del mismo tamaño, debajo del texto */
  .hero__ctas { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 0.5rem; width: min(100%, 22rem); }
  .hero__ctas .btn { width: 100%; }
  .hero__bars { display: flex; gap: 6px; margin-top: 0.75rem; }
  .hero__bars i { width: 22px; height: 2px; background: rgb(255 255 255 / 0.3); border-radius: 2px; overflow: hidden; }
  .hero__bars b { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .hero__bars i.is-active b { animation: bar 7000ms linear forwards; }
  @keyframes bar { to { transform: scaleX(1); } }

  /* Logos a la derecha: columna, mismo ancho, repartidos en todo el alto */
  .hero__brands { list-style: none; padding: 0; display: flex; flex-direction: column; justify-content: space-between; align-items: center; width: 64px; }
  .hero__brands li { width: 100%; display: grid; place-items: center; }
  .hero__brands img { width: 100%; height: auto; max-height: 64px; object-fit: contain; opacity: 0.88; }

  .hero__content > *, .hero__brands li { animation: rise 1s var(--ease-out) both; }
  .hero__content > :nth-child(2) { animation-delay: 90ms; }
  .hero__content > :nth-child(3) { animation-delay: 180ms; }
  .hero__content > :nth-child(4) { animation-delay: 270ms; }
  .hero__brands li:nth-child(n) { animation-delay: calc(300ms + var(--i, 0) * 60ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }

  @media (max-width: 767px) {
    .hero { padding-inline: 0.5rem; }
    .hero__tile { min-height: calc(100svh - var(--nav-h) - 1.25rem); border-radius: var(--radius-m); padding: 1.25rem; gap: 1rem; }
    .hero__brands { width: 38px; }
    .hero__brands img { max-height: 38px; }
    .hero__ctas { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__slide :global(img) { transform: none; transition: none; } }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const bars = [...hero.querySelectorAll<HTMLElement>('.hero__bars i')];
    const cap = hero.querySelector('[data-slide-caption]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      slides[i].classList.remove('is-active'); bars[i].classList.remove('is-active');
      i = (n + slides.length) % slides.length;
      slides[i].querySelector('img')?.setAttribute('loading', 'eager');
      slides[i].classList.add('is-active'); bars[i].classList.add('is-active');
      cap.textContent = slides[i].dataset.caption ?? '';
    };
    const stop = () => window.clearInterval(timer);
    const start = () => { stop(); if (!reduce) timer = window.setInterval(() => show(i + 1), 7000); };
    window.addEventListener('load', () => slides[1]?.querySelector('img')?.setAttribute('loading', 'eager'));
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(hero);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>
