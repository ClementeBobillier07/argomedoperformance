---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props { href: string; image: ImageMetadata; alt: string; brand: string; model: string; year?: string; meta?: string; status?: string }
const { href, image, alt, brand, model, year, meta, status } = Astro.props;
---
<article class="car">
  <a href={href} class="car__link">
    <div class="car__media photo">
      <Picture src={image} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 767px) 85vw, 32vw" formats={['avif', 'webp']} class="graded" loading="lazy" />
      {status && <span class="car__status label">{status}</span>}
    </div>
    <div class="car__body">
      <p class="label">{brand}{year && <> · <span class="num">{year}</span></>}</p>
      <h3 class="t-h3">{model}</h3>
      {meta && <p class="t-small">{meta}</p>}
      <span class="link-arrow car__cta">Consultar <Icon name="arrow" /></span>
    </div>
  </a>
</article>

<style>
  .car__link { display: grid; gap: 1.25rem; }
  .car__media { aspect-ratio: 4 / 3; border-radius: var(--radius-m); }
  .car__media :global(img) { transition: transform 1.2s var(--ease-out); }
  .car__status {
    position: absolute; top: 1rem; left: 1rem;
    padding: 0.4rem 0.7rem; border-radius: var(--radius-pill);
    background: var(--glass); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    color: var(--text); font-size: 0.6875rem;
  }
  .car__body { display: grid; gap: 0.45rem; }
  .car__cta { justify-self: start; margin-top: 0.5rem; font-size: 0.9375rem; }
  @media (hover: hover) {
    .car__link:hover .car__media :global(img) { transform: scale(1.04); }
    .car__link:hover .car__cta { background-size: 100% 1px; }
    .car__link:hover .car__cta :global(svg) { transform: translateX(3px); }
  }
</style>
