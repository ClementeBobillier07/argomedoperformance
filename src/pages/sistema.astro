---
// Fase 1: style tile / sistema visual para aprobar desde el teléfono
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CarCard from '../components/CarCard.astro';
import PhotoSection from '../components/PhotoSection.astro';
import Icon from '../components/Icon.astro';
import { site, waLink } from '../data/site';

import lambo from '../../assets/fotos-hd/biblioteca/2013-08/20130827_114447.jpg';
import corvette from '../../assets/fotos-hd/biblioteca/2011-09/24.jpg';
import porsche from '../../assets/fotos-hd/biblioteca/2011-09/25.jpg';
import sala from '../../assets/fotos-hd/biblioteca/2011-09/sala_reuniones_argomedo_1.jpg';
import mecanico from '../../assets/fotos-hd/biblioteca/2011-09/36.jpg';
import antes from '../../assets/fotos-originales/tema/home.jpg';
import despues from '../../assets/fotos-hd/tema/home.jpg';

const colors = [
  { name: 'Fondo', token: '--bg', hex: '#0A0A0B', use: 'Fondo general. Casi negro, nunca negro puro.' },
  { name: 'Superficie', token: '--surface', hex: '#141416', use: 'Tarjetas, formularios, footer.' },
  { name: 'Superficie 2', token: '--surface-2', hex: '#1C1C1F', use: 'Campos, estados hover.' },
  { name: 'Texto', token: '--text', hex: '#F5F5F7', use: 'Titulares y texto principal.' },
  { name: 'Texto 2', token: '--text-2', hex: '#A1A1A6', use: 'Párrafos, pies de foto. Contraste 7.9:1.' },
  { name: 'Amarillo Argomedo', token: '--accent', hex: '#FFEC00', use: 'Solo acentos: foco, punto activo, números, hover.', accent: true },
];
const type = [
  { cls: 't-display', sample: 'Alto rendimiento.', spec: 'Display · Geist 600 · 48–128 px · −4,5 %' },
  { cls: 't-h1', sample: 'Garantía profesional.', spec: 'H1 · Geist 600 · 40–88 px · −4 %' },
  { cls: 't-h2', sample: 'Ingeniería automotriz y mecánica de alta calidad.', spec: 'H2 · Geist 600 · 32–64 px · −3,2 %' },
  { cls: 't-h3', sample: 'Lamborghini Gallardo LP560-4', spec: 'H3 · Geist 560 · 22–30 px · −2 %' },
  { cls: 't-lead', sample: 'Taller familiar especializado en autos de lujo, deportivos y clásicos.', spec: 'Lead · Geist 400 · 18–22 px' },
  { cls: 't-body', sample: 'Desde sus inicios, las oficinas, el taller mecánico y el taller de fabricación de partes y piezas han estado en María Eugenia 3454, Recoleta.', spec: 'Texto · Geist 400 · 17 px · interlineado 1,6' },
  { cls: 'label', sample: 'Recoleta · Santiago · Desde 1970', spec: 'Etiqueta · Geist Mono 450 · 12 px · +14 % · mayúsculas' },
];
---
<Base title="Sistema visual (Fase 1)" description="Sistema visual del rediseño de Argomedo Performance: colores, tipografía, botones y componentes." noindex>
  <Hero />

  <section class="section container"><div class="intro">
    <p class="label label--accent" data-reveal>Fase 1 · Sistema visual</p>
    <h2 class="t-h1" data-reveal style="--d:80ms">Showroom de noche.<br /><span class="t-soft">Los autos iluminados, el resto en silencio.</span></h2>
    <p class="t-lead" data-reveal style="--d:160ms">Esta página reúne las piezas con las que se construye el sitio completo. Arriba ves el hero real: navbar translúcida, fotos mejoradas con IA y las marcas en blanco. Todo lo de abajo es el sistema: color, tipografía, botones y componentes.</p>
  </div></section>

  <!-- COLOR -->
  <section class="section container block" aria-labelledby="t-color">
    <header class="block__head">
      <p class="label num">01</p>
      <h2 id="t-color" class="t-h2">Color</h2>
      <p class="t-body">Una escala de grises cálidos sobre casi negro, como la de Apple. El amarillo de Argomedo se conserva idéntico, pero pasa de ser un fondo a ser un acento: aparece solo donde hay que mirar.</p>
    </header>
    <ul class="swatches">
      {colors.map((c) => (
        <li class:list={['swatch', { 'swatch--accent': c.accent }]} data-reveal>
          <span class="swatch__chip" style={`background:${c.hex}`}></span>
          <div>
            <p class="swatch__name">{c.name}</p>
            <p class="label num">{c.hex} · {c.token}</p>
            <p class="t-small">{c.use}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="ratio" data-reveal>
      <div class="ratio__bar"><i style="flex:70"></i><i style="flex:18"></i><i style="flex:10"></i><i class="is-accent" style="flex:2"></i></div>
      <p class="label">Proporción en pantalla · fondo 70 % · superficies 18 % · texto 10 % · <span class="label--accent">amarillo ≈ 2 %</span></p>
    </div>
  </section>

  <!-- TIPOGRAFÍA -->
  <section class="section container block" aria-labelledby="t-type">
    <header class="block__head">
      <p class="label num">02</p>
      <h2 id="t-type" class="t-h2">Tipografía</h2>
      <p class="t-body">Geist, una grotesca neutra y precisa en la línea de SF Pro, para todo. Geist Mono para etiquetas, años y cifras: evoca el lenguaje técnico de un tablero. El tracking se ajusta por tamaño, más cerrado mientras más grande es el texto.</p>
    </header>
    <ol class="specimens">
      {type.map((t) => (
        <li data-reveal>
          <p class="label num spec">{t.spec}</p>
          <p class={t.cls}>{t.sample}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- BOTONES -->
  <section class="section container block" aria-labelledby="t-btn">
    <header class="block__head">
      <p class="label num">03</p>
      <h2 id="t-btn" class="t-h2">Botones y links</h2>
      <p class="t-body">Píldoras de 52 px (táctiles en el celular). Responden al presionar, no al soltar. El hover suma un halo o un borde amarillo; el color nunca es la única señal.</p>
    </header>
    <div class="btn-grid" data-reveal>
      <div class="btn-demo"><a class="btn btn--primary" href="#">Ver showroom <Icon name="arrow" /></a><p class="label">Primario</p></div>
      <div class="btn-demo"><a class="btn btn--glass" href="#">Contáctenos</a><p class="label">Vidrio (sobre fotos)</p></div>
      <div class="btn-demo"><a class="btn btn--ghost" href="#">Cómo llegar <Icon name="arrow" /></a><p class="label">Contorno</p></div>
      <div class="btn-demo"><a class="btn btn--sm btn--glass" href="#">Agendar visita</a><p class="label">Pequeño · navbar</p></div>
      <div class="btn-demo"><a class="link-arrow" href="#">Conoce nuestro equipo <Icon name="arrow" /></a><p class="label">Link con flecha</p></div>
      <div class="btn-demo"><a class="btn btn--ghost" href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a><p class="label">WhatsApp (también flotante ↘)</p></div>
    </div>
  </section>

  <!-- TARJETAS DE AUTOS -->
  <section class="section block" aria-labelledby="t-cars">
    <header class="block__head container">
      <p class="label num">04</p>
      <h2 id="t-cars" class="t-h2">Últimos autos en venta</h2>
      <p class="t-body">Carrusel horizontal que se desliza con el dedo (scroll-snap). Foto grande, marca en mono, modelo y un único CTA: consultar.</p>
    </header>
    <div class="rail" data-reveal>
      <CarCard href="#" image={lambo} alt="Lamborghini Gallardo LP560-4 blanco en el showroom" brand="Lamborghini" model="Gallardo LP560-4" year="2010" meta="Blanco · 0 millas" status="Disponible" />
      <CarCard href="#" image={corvette} alt="Chevrolet Corvette C6 negro, vista frontal" brand="Chevrolet" model="Corvette C6" meta="Negro · consultar kilometraje" />
      <CarCard href="#" image={porsche} alt="Porsche 911 azul, vista frontal" brand="Porsche" model="911 Carrera" meta="Azul · consultar kilometraje" />
    </div>
    <p class="container t-small t-muted rail-note">Ejemplo con fotos de archivo. Los autos reales vendrán del inventario actual de Argomedo.</p>
  </section>

  <!-- FOTO + TEXTO -->
  <PhotoSection
    image={sala}
    alt="Sala de reuniones de Argomedo Performance"
    number="05"
    kicker="Visítanos"
    stats={[{ value: '1970', label: 'Fundación' }, { value: site.area, label: 'Instalaciones' }, { value: '55+', label: 'Años de oficio' }]}
  >
    <h2 class="t-h1">Negocios, compra y venta.<br /><span class="t-soft">Como en casa.</span></h2>
    <p class="t-lead">Te esperamos en nuestra sala de reuniones, con el respaldo y la experiencia de tres generaciones en cada decisión.</p>
    <div class="row">
      <a class="btn btn--primary" href="#">Cómo llegar <Icon name="arrow" /></a>
      <a class="btn btn--glass" href="#">Importación directa</a>
    </div>
  </PhotoSection>

  <!-- UPSCALE -->
  <section class="section container block" aria-labelledby="t-photo">
    <header class="block__head">
      <p class="label num">06</p>
      <h2 id="t-photo" class="t-h2">Fotos mejoradas con IA</h2>
      <p class="t-body">Las fotos originales tienen entre 790 y 960 px de ancho. Con Real-ESRGAN las llevamos a 2560 px y les aplicamos una gradación común, para que las de 2011 y las de 2013 se vean como una sola sesión. Arrastra la línea para comparar.</p>
    </header>
    <div class="compare" data-compare data-reveal>
      <Image src={despues} alt="Foto del showroom mejorada con IA" widths={[828, 1600, 2400]} sizes="(max-width: 1440px) 100vw, 1440px" class="compare__img" />
      <div class="compare__before">
        <Image src={antes} alt="Foto original del showroom, 960 px" width={960} class="compare__img compare__img--soft" />
      </div>
      <input type="range" min="0" max="100" value="50" aria-label="Comparar original y mejorada" />
      <span class="compare__handle" aria-hidden="true"></span>
      <span class="label compare__tag compare__tag--l">Original · 960 px</span>
      <span class="label compare__tag compare__tag--r">IA · 2560 px</span>
    </div>
  </section>

  <!-- FORMULARIO + PRENSA -->
  <section class="section container block" aria-labelledby="t-form">
    <header class="block__head">
      <p class="label num">07</p>
      <h2 id="t-form" class="t-h2">Formulario y citas</h2>
      <p class="t-body">Mismos campos que el formulario actual, con etiquetas visibles, validación en línea y el motivo preseleccionado cuando vienes desde un servicio o un auto.</p>
    </header>
    <div class="duo">
      <form class="form" data-reveal onsubmit="return false">
        <div class="field"><input id="f-nombre" name="nombre" placeholder=" " autocomplete="name" required /><label for="f-nombre">Nombre</label></div>
        <div class="field"><input id="f-email" name="email" type="email" placeholder=" " autocomplete="email" required /><label for="f-email">Email</label></div>
        <div class="field"><input id="f-tel" name="telefono" type="tel" placeholder=" " autocomplete="tel" inputmode="tel" required /><label for="f-tel">Teléfono</label></div>
        <div class="field field--select">
          <select id="f-razon" name="razon" required>
            <option value="mecanica">Servicio de mecánica</option>
            <option value="repuestos">Repuestos</option>
            <option value="importacion">Importación</option>
            <option value="pintura">Pintura</option>
            <option value="cotizacion">Cotización</option>
            <option value="reunion">Agendar reunión</option>
          </select>
          <label for="f-razon">Motivo</label>
        </div>
        <div class="field field--full"><textarea id="f-msg" name="mensaje" rows="3" placeholder=" " required></textarea><label for="f-msg">Cuéntanos sobre tu auto</label></div>
        <button class="btn btn--primary" type="submit">Enviar consulta <Icon name="arrow" /></button>
      </form>

      <figure class="quote" data-reveal style="--d:120ms">
        <p class="label">La Segunda</p>
        <blockquote class="t-h3">«El “secreto” que atrae a empresarios de elite a una “picada” en Recoleta».</blockquote>
        <figcaption><a class="link-arrow" href="#">Leer artículo (PDF) <Icon name="arrow" /></a></figcaption>
      </figure>
    </div>
  </section>

  <section class="section container closing">
    <div class="closing__media photo" data-reveal>
      <Picture src={mecanico} alt="Mecánico de Argomedo Performance trabajando en un auto de competición" widths={[828, 1600, 2400]} sizes="100vw" formats={['avif', 'webp']} class="graded" />
    </div>
    <p class="t-display closing__title" data-reveal>Garantía<br /><span class="t-soft">profesional.</span></p>
  </section>
</Base>

<style>
  .intro { display: grid; gap: 1.75rem; max-width: 64rem; }
  .intro .t-lead { max-width: 42rem; }

  .block { display: grid; gap: clamp(2.5rem, 5vw, 4.5rem); border-top: 1px solid var(--hairline); }
  .block__head { display: grid; gap: 1rem; max-width: 44rem; }
  .block__head .label { color: var(--accent); }

  .swatches { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .swatch { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1.1rem; align-items: center; padding: 1rem; border-radius: var(--radius-m); background: var(--surface); box-shadow: inset 0 0 0 1px var(--hairline); }
  .swatch__chip { width: 4.5rem; aspect-ratio: 1; border-radius: var(--radius-s); box-shadow: inset 0 0 0 1px var(--hairline-strong); }
  .swatch__name { font-weight: 560; margin-bottom: 0.2rem; }
  .swatch--accent { box-shadow: inset 0 0 0 1px rgb(255 236 0 / 0.4); }
  .ratio { display: grid; gap: 0.9rem; }
  .ratio__bar { display: flex; height: 14px; border-radius: 7px; overflow: hidden; box-shadow: inset 0 0 0 1px var(--hairline); }
  .ratio__bar i:nth-child(1) { background: var(--bg); }
  .ratio__bar i:nth-child(2) { background: var(--surface-2); }
  .ratio__bar i:nth-child(3) { background: var(--text); }
  .ratio__bar i.is-accent { background: var(--accent); }

  .specimens { list-style: none; padding: 0; display: grid; }
  .specimens li { display: grid; gap: 0.75rem; padding-block: clamp(1.5rem, 3vw, 2.25rem); border-bottom: 1px solid var(--hairline); }
  .specimens .spec { color: var(--text-3); }
  .specimens .t-body { max-width: var(--max-text); }

  .btn-grid { display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); padding: clamp(1.5rem, 4vw, 3rem); border-radius: var(--radius-l); background: radial-gradient(120% 140% at 10% 0%, #1d1d21 0%, var(--surface) 60%); box-shadow: inset 0 0 0 1px var(--hairline); }
  .btn-demo { display: grid; gap: 0.9rem; justify-items: start; align-content: start; }
  .btn-demo .label { color: var(--text-3); }

  .rail {
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(18rem, 32%);
    gap: 1.25rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter);
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    padding-bottom: 1rem; scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .rail::-webkit-scrollbar { display: none; }
  .rail > :global(*) { scroll-snap-align: start; }
  .rail-note { margin-top: -1.5rem; }
  @media (max-width: 767px) { .rail { grid-auto-columns: 84%; } }

  .row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.75rem; }

  .compare { position: relative; aspect-ratio: 2560 / 1117; border-radius: var(--radius-l); overflow: hidden; background: var(--surface); --x: 50%; }
  .compare :global(.compare__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .compare__before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--x)) 0 0); }
  .compare input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; margin: 0; touch-action: pan-y; }
  .compare__handle { position: absolute; top: 0; bottom: 0; left: var(--x); width: 2px; background: var(--accent); transform: translateX(-1px); pointer-events: none; }
  .compare__handle::after { content: '‹ ›'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--glass); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); box-shadow: inset 0 0 0 1px var(--hairline-strong); font-size: 0.9rem; color: var(--text); }
  .compare__tag { position: absolute; bottom: 1rem; padding: 0.4rem 0.7rem; border-radius: var(--radius-pill); background: var(--glass); color: var(--text); pointer-events: none; font-size: 0.6875rem; }
  .compare__tag--l { left: 1rem; }
  .compare__tag--r { right: 1rem; }

  .duo { display: grid; gap: 1.5rem; grid-template-columns: 1.3fr 1fr; align-items: stretch; }
  @media (max-width: 899px) { .duo { grid-template-columns: 1fr; } }
  .form { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; padding: clamp(1.25rem, 3vw, 2rem); border-radius: var(--radius-l); background: var(--surface); box-shadow: inset 0 0 0 1px var(--hairline); }
  .form .btn { grid-column: 1 / -1; justify-self: start; margin-top: 0.5rem; }
  .field { position: relative; }
  .field--full { grid-column: 1 / -1; }
  .field input, .field select, .field textarea {
    width: 100%; min-height: 60px; padding: 1.6rem 1rem 0.55rem;
    border: 0; border-radius: var(--radius-s); background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--hairline); font-size: 1rem; /* 16px: evita zoom en iOS */
    transition: box-shadow var(--dur-fast) var(--ease-out);
    appearance: none; -webkit-appearance: none;
  }
  .field textarea { resize: vertical; min-height: 120px; }
  .field--select::after { content: ''; position: absolute; right: 1.1rem; top: 50%; width: 7px; height: 7px; border-right: 1.5px solid var(--text-2); border-bottom: 1.5px solid var(--text-2); transform: translateY(-30%) rotate(45deg); pointer-events: none; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; box-shadow: inset 0 0 0 1.5px var(--accent); }
  .field label { position: absolute; left: 1rem; top: 1.15rem; color: var(--text-3); font-size: 1rem; pointer-events: none; transform-origin: left top; transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast); }
  .field input:focus + label, .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label, .field textarea:not(:placeholder-shown) + label,
  .field select + label { transform: translateY(-0.6rem) scale(0.75); color: var(--text-2); }
  @media (max-width: 599px) { .form { grid-template-columns: 1fr; } }

  .quote { display: grid; align-content: space-between; gap: 2rem; padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: var(--radius-l); background: var(--surface); box-shadow: inset 0 0 0 1px var(--hairline); }
  .quote blockquote { font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem); line-height: 1.15; letter-spacing: -0.025em; }

  .closing { position: relative; display: grid; }
  .closing__media { aspect-ratio: 16 / 7; border-radius: var(--radius-l); }
  .closing__media :global(img) { filter: saturate(0.7) brightness(0.55); }
  .closing__title { position: absolute; left: calc(var(--gutter) + clamp(1.5rem, 4vw, 3.5rem)); bottom: clamp(1.5rem, 4vw, 3.5rem); }
  @media (max-width: 767px) { .closing__media { aspect-ratio: 4 / 5; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((el) => {
    const input = el.querySelector('input')!;
    const set = () => el.style.setProperty('--x', `${input.value}%`);
    input.addEventListener('input', set);
    set();
  });
</script>
